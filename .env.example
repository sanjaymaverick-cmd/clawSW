# Copy to .env and fill in real values before `docker compose up`.

# Postgres superuser password for the clawsw database (internal network only).
POSTGRES_PASSWORD=pick-a-strong-password

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=pick-a-long-random-secret

# Initial owner account, created on first API startup if no users exist.
# Log in with these credentials, then change the password via the dashboard.
ADMIN_NAME=Owner
ADMIN_EMAIL=you@yourcompany.example
ADMIN_PASSWORD=pick-a-strong-password

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Login rate limiting (Phase 9) ----
# Brute-force lockout on /auth/login, keyed by (email, client IP). After
# LOGIN_MAX_ATTEMPTS consecutive failures the pair is locked out for
# LOGIN_LOCKOUT_MINUTES. Defaults below match config.py.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# URL browsers use to reach the API from the public website (Phase 4).
# On a LAN deployment set this to the server's address, e.g. http://192.168.1.10:8000
PUBLIC_API_URL=http://localhost:8000

# ---- Encrypted backups (Phase 6) ----
# Passphrase encrypting every backup (AES-256). Generate: openssl rand -hex 32
# Keep a copy somewhere safe OFF this machine — without it backups are
# unrecoverable. Restores need the same value.
BACKUP_PASSPHRASE=pick-a-long-random-passphrase
# Where encrypted backups land on the host. Point this at a SECOND local
# disk (e.g. /mnt/backup-disk/clawsw) so one disk failure can't take both
# the database and its backups.
BACKUP_DIR=./backups
# How often (seconds) the backup cron runs; default daily.
BACKUP_INTERVAL_SECONDS=86400
# Encrypted backups older than this many days are pruned.
BACKUP_RETENTION_DAYS=30

# ---- Tally bridge (Phase 5) ----
# Tally Prime's XML/HTTP gateway ("Enable ODBC/XML Server" in Tally config).
# Test against a SANDBOX company file before pointing at production data.
# host.docker.internal reaches the docker host; use the Tally machine's LAN
# address if Tally runs elsewhere, e.g. http://192.168.1.20:9000
TALLY_URL=http://host.docker.internal:9000
# Company to import into; leave empty to use the company open in Tally.
TALLY_COMPANY=
# Ledger names — must already exist in the Tally company file.
TALLY_SALES_LEDGER=Sales
TALLY_PARTY_LEDGER=Website Customers
# How often (seconds) the bridge pushes orders / pulls payment status.
TALLY_SYNC_INTERVAL_SECONDS=60

# ---- AI query layer (Phase 7) ----
# Anthropic API key for /ai-query. Server-side only — it is handed to the
# api container alone and never reaches the dashboard or website bundles.
# Leave empty to run with AI queries disabled (the endpoint returns 503).
ANTHROPIC_API_KEY=
# Model used for AI queries; pinned to the current docs-listed default.
ANTHROPIC_MODEL=claude-opus-4-8
